# Veritabanı (Docker container içinde kalıcı volume üzerinde)
DATABASE_URL=file:/app/data/aritman.db

# Güçlü rastgele anahtar oluşturmak için: openssl rand -hex 32
PAYLOAD_SECRET=buraya-uzun-rastgele-bir-anahtar-yazin

# Canlı domain adresi
NEXT_PUBLIC_SITE_URL=https://aritman.com.tr

# İlk kurulumda seed çalıştırırken oluşturulacak yönetici bilgileri (opsiyonel)
SEED_ADMIN_EMAIL=admin@aritman.com.tr
SEED_ADMIN_PASSWORD=Aritman2026!Degistir
